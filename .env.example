# Migrations e seed (dono das tabelas)
DATABASE_URL="postgresql://core_owner:core_owner_dev@localhost:5432/core360"
# Aplicação (sem BYPASSRLS; toda consulta passa pela RLS)
APP_DATABASE_URL="postgresql://core_app:core_app_dev@localhost:5432/core360"
# Login e convites (só tabelas de identidade)
AUTH_DATABASE_URL="postgresql://core_auth:core_auth_dev@localhost:5432/core360"
# Avisos: despacho para o app e WhatsApp (lê chamados, grava avisos)
WORKER_DATABASE_URL="postgresql://core_worker:core_worker_dev@localhost:5432/core360"

# Better Auth: gere com `openssl rand -base64 32`
BETTER_AUTH_SECRET="troque-por-um-segredo-de-pelo-menos-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"

# Testes (cada execução cria e apaga um banco temporário com estes usuários)
TEST_DATABASE_URL="postgresql://core_owner:core_owner_dev@localhost:5432/core360_test"
TEST_APP_DATABASE_URL="postgresql://core_app:core_app_dev@localhost:5432/core360_test"
TEST_AUTH_DATABASE_URL="postgresql://core_auth:core_auth_dev@localhost:5432/core360_test"
TEST_WORKER_DATABASE_URL="postgresql://core_worker:core_worker_dev@localhost:5432/core360_test"

# Fotos (S3-compatível). Dev: MinIO do docker-compose. Produção: Cloudflare R2.
# STORAGE_DRIVER=memory guarda em memória (só para testes/dev sem MinIO).
# STORAGE_DRIVER=database guarda no próprio banco (ambiente de teste na Vercel + Neon).
STORAGE_DRIVER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="core360-evidencias"
S3_ACCESS_KEY_ID="core360"
S3_SECRET_ACCESS_KEY="core360-dev-secret"

# Endereço público do app (links dos avisos). Padrão: BETTER_AUTH_URL.
APP_URL="http://localhost:3000"
# Chamada periódica do despacho de avisos e SLA (GET /api/cron/dispatch com "Authorization: Bearer ...")
CRON_SECRET="troque-por-um-segredo-longo"

# WhatsApp (API oficial do WhatsApp Business, Meta). Veja docs/whatsapp.md.
# off = não envia; log = só mostra no terminal; cloud = envia de verdade.
WHATSAPP_DRIVER="log"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
