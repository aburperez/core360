// CORE 360 — schema do banco.
// Regras que o Prisma não expressa (CHECKs, índices parciais, triggers,
// auditoria imutável e, na etapa 4, RLS) ficam em SQL nas migrations.
// Proposta de referência: docs/01-arquitetura-e-modelo-de-dados.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED

  @@map("agency_status")
}

/// As 11 etapas do evento (roadmap do Abu), mais Cancelado.
enum EventStatus {
  BRIEFING
  PLANEJAMENTO
  ORCAMENTO
  APROVACAO
  CONTRATACAO
  PRE_PRODUCAO
  MONTAGEM
  EVENTO
  DESMONTAGEM
  FECHAMENTO
  CONCLUIDO
  CANCELADO

  @@map("event_status")
}

/// Papéis por evento. ADMIN não existe aqui de propósito: o Admin é da agência
/// (agency_admins) e vale para todos os eventos dela.
enum ParticipantRole {
  GERENTE
  HEAD
  OPERACIONAL
  CLIENTE
  /// Só a Pré-produção do evento (sem campo).
  PRE_PRODUTOR

  @@map("participant_role")
}

enum OccurrenceType {
  OCORRENCIA
  TAREFA

  @@map("occurrence_type")
}

enum OccurrenceStatus {
  PENDENTE
  EM_ANDAMENTO
  URGENTE
  BLOQUEIO
  CONCLUIDO
  CANCELADO

  @@map("occurrence_status")
}

enum Priority {
  BAIXA
  NORMAL
  ALTA
  CRITICA

  @@map("priority")
}

enum ValidationStatus {
  PENDENTE
  APROVADA
  REPROVADA

  @@map("validation_status")
}

enum AttachmentKind {
  EVIDENCIA
  CONCLUSAO

  @@map("attachment_kind")
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  CONCLUDE
  CANCEL
  REASSIGN
  TEAM_CHANGE
  ROLE_CHANGE
  VALIDATE
  ACTIVATE
  DEACTIVATE
  DELETE
  LOGIN
  LOGIN_DENIED

  @@map("audit_action")
}

/// Conferência do item no campo.
enum ReceiptStatus {
  PENDENTE
  OK
  DIFERENTE

  @@map("receipt_status")
}

/// Como o item é cobrado (coluna "Tipo de faturamento" da matriz de orçamento).
enum CostBilling {
  FATURA
  NOTA_FISCAL
  DIRETO

  @@map("cost_billing")
}

enum SlaProposalStatus {
  PENDENTE
  APROVADA
  AJUSTADA
  RECUSADA

  @@map("sla_proposal_status")
}

enum NotificationType {
  NOVA
  URGENTE
  BLOQUEIO
  SLA_PROXIMO
  SLA_ESTOURADO
  CONCLUIDA
  ATRIBUIDA
  REPROVADA
  LEMBRETE
  COTACAO

  @@map("notification_type")
}

enum DeliveryStatus {
  PENDENTE
  ENVIADO
  FALHOU
  IGNORADO

  @@map("delivery_status")
}

// ─────────────────────── Identidade e sessão ───────────────────────
// users guarda só a identidade. O que a pessoa pode ver vem de participants.
// Session/Account/Verification seguem o formato do Better Auth (etapa 2).

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  email         String   @unique @db.Citext
  name          String
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  /// Admin da plataforma (dono do CORE 360): cria e suspende agências. Não
  /// enxerga os eventos das agências por isso; só como Admin de uma agência.
  isAdmin       Boolean  @default(false) @map("is_admin")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                 Session[]
  accounts                 Account[]
  participations           Participant[]        @relation("ParticipantUser")
  documentsUploaded        EventDocument[]      @relation("EventDocumentUploadedBy")
  contractsCreated         Contract[]           @relation("ContractCreatedBy")
  contractsSigned          Contract[]           @relation("ContractSignedBy")
  supplierRatings          SupplierRating[]
  milestonesDone           EventMilestone[]     @relation("EventMilestoneDoneBy")
  milestonesCreated        EventMilestone[]     @relation("EventMilestoneCreatedBy")
  tasksDone                EventTask[]          @relation("EventTaskDoneBy")
  tasksCreated             EventTask[]          @relation("EventTaskCreatedBy")
  arrivalsArrived          Arrival[]            @relation("ArrivalArrivedBy")
  arrivalsStatus           Arrival[]            @relation("ArrivalStatusBy")
  arrivalsCreated          Arrival[]            @relation("ArrivalCreatedBy")
  contractsCancelled       Contract[]           @relation("ContractCancelledBy")
  participantsCreated      Participant[]        @relation("ParticipantCreatedBy")
  invitationsCreated       Invitation[]
  occurrencesCreated       Occurrence[]         @relation("OccurrenceCreatedBy")
  occurrencesConcluded     Occurrence[]         @relation("OccurrenceConcludedBy")
  occurrencesValidated     Occurrence[]         @relation("OccurrenceValidatedBy")
  attachments              Attachment[]
  notifications            Notification[]
  whatsapp                 WhatsappContact?
  serviceTypesCreated      ServiceType[]        @relation("ServiceTypeCreatedBy")
  slaProposed              SlaProposal[]        @relation("SlaProposalProposedBy")
  slaReviewed              SlaProposal[]        @relation("SlaProposalReviewedBy")
  briefingsUpdated         Briefing[]           @relation("BriefingUpdatedBy")
  dailyNotesUpdated        DailyNote[]          @relation("DailyNoteUpdatedBy")
  functionsCreated         EventFunction[]      @relation("EventFunctionCreatedBy")
  activitiesCreated        Activity[]           @relation("ActivityCreatedBy")
  clientViewsUpdated       ClientView[]         @relation("ClientViewUpdatedBy")
  profilesUpdated          ParticipantProfile[] @relation("ParticipantProfileUpdatedBy")
  directors                Director[]           @relation("DirectorUser")
  directorsCreated         Director[]           @relation("DirectorCreatedBy")
  agencyAdmins             AgencyAdmin[]        @relation("AgencyAdminUser")
  agencyAdminsCreated      AgencyAdmin[]        @relation("AgencyAdminCreatedBy")
  agenciesCreated          Agency[]             @relation("AgencyCreatedBy")
  agencyInvitations        AgencyInvitation[]
  quotesCreated            QuoteRequest[]       @relation("QuoteCreatedBy")
  quotesSlaSet             QuoteRequest[]       @relation("QuoteSlaSetBy")
  quotesClosed             QuoteRequest[]       @relation("QuoteClosedBy")
  supplierQuotes           SupplierQuote[]      @relation("SupplierQuoteCreatedBy")
  supplierQuotesNegotiated SupplierQuote[]      @relation("SupplierQuoteNegotiatedBy")
  suppliersCreated         Supplier[]           @relation("SupplierCreatedBy")
  supplierBonuses          SupplierBonus[]      @relation("SupplierBonusUpdatedBy")
  visitsCreated            TechnicalVisit[]     @relation("TechnicalVisitCreatedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────────── Agências ─────────────────────────────

/// Cada agência que aluga o CORE 360 é um espaço fechado: clientes, eventos e
/// diretores pertencem a uma agência, e o banco não deixa uma ver a outra.
model Agency {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  status      AgencyStatus @default(ACTIVE)
  /// Contador do número do evento na agência (EVT001). Mantido por trigger.
  eventSeq    Int          @default(0) @map("event_seq")
  createdById String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?              @relation("AgencyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  admins      AgencyAdmin[]
  invitations AgencyInvitation[]
  clients     Client[]
  events      Event[]
  directors   Director[]
  suppliers   Supplier[]

  @@map("agencies")
}

/// Admin de uma agência: cria clientes e eventos e cadastra diretores dela.
enum AgencyAdminRole {
  ADMIN
  SUPORTE

  @@map("agency_admin_role")
}

model AgencyAdmin {
  id          String          @id @default(uuid(7)) @db.Uuid
  agencyId    String          @map("agency_id") @db.Uuid
  name        String
  email       String          @db.Citext
  /// SUPORTE: quem a agência autorizou a entrar para ajudar. Pode o que o
  /// Admin pode nos eventos, menos cadastrar ou tirar Admins e Suporte.
  role        AgencyAdminRole @default(ADMIN)
  /// Admin = diretor de produção: o banco liga os dois e mantém nome, ativo e conta iguais.
  directorId  String?         @unique @map("director_id") @db.Uuid
  /// Preenchido quando a pessoa aceita o convite.
  userId      String?         @map("user_id") @db.Uuid
  active      Boolean         @default(true)
  createdById String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency      Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  director    Director?          @relation(fields: [directorId], references: [id], onDelete: Restrict)
  user        User?              @relation("AgencyAdminUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy   User?              @relation("AgencyAdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invitations AgencyInvitation[]

  @@unique([agencyId, email])
  @@unique([agencyId, id])
  @@index([userId])
  @@map("agency_admins")
}

/// Convite para Admin de agência. Guarda só o hash do token.
model AgencyInvitation {
  id            String    @id @default(uuid(7)) @db.Uuid
  agencyId      String    @map("agency_id") @db.Uuid
  agencyAdminId String    @map("agency_admin_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  agency    Agency      @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  admin     AgencyAdmin @relation(fields: [agencyId, agencyAdminId], references: [agencyId, id], onDelete: Restrict)
  createdBy User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([agencyAdminId])
  @@map("agency_invitations")
}

// ───────────────────────── Estrutura do evento ─────────────────────────

model Client {
  id          String       @id @default(uuid(7)) @db.Uuid
  agencyId    String       @map("agency_id") @db.Uuid
  name        String
  document    String?
  contactName String?      @map("contact_name")
  email       String?      @db.Citext
  phone       String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  events      Event[]
  occurrences Occurrence[]

  @@unique([agencyId, id])
  @@index([agencyId])
  @@map("clients")
}

model Event {
  id               String      @id @default(uuid(7)) @db.Uuid
  /// Sempre a agência do cliente (chave composta com clients).
  agencyId         String      @map("agency_id") @db.Uuid
  clientId         String      @map("client_id") @db.Uuid
  name             String
  description      String?
  startsAt         DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime    @map("ends_at") @db.Timestamptz(3)
  venue            String?
  address          String?
  timezone         String      @default("America/Sao_Paulo")
  status           EventStatus @default(BRIEFING)
  /// Ficha do evento (fase 1 do roadmap). Valores ficam em event_finances.
  project          String?
  eventType        String?     @map("event_type")
  city             String?
  state            String?
  setupStartsAt    DateTime?   @map("setup_starts_at") @db.Timestamptz(3)
  setupEndsAt      DateTime?   @map("setup_ends_at") @db.Timestamptz(3)
  teardownStartsAt DateTime?   @map("teardown_starts_at") @db.Timestamptz(3)
  teardownEndsAt   DateTime?   @map("teardown_ends_at") @db.Timestamptz(3)
  expectedAudience Int?        @map("expected_audience")
  /// Responsável geral e produtor responsável: Gerente ou Pré-produtor do evento.
  leadId           String?     @map("lead_id") @db.Uuid
  producerId       String?     @map("producer_id") @db.Uuid
  notes            String?
  /// Contador do número curto das ocorrências (#142). Mantido por trigger.
  occurrenceSeq    Int         @default(0) @map("occurrence_seq")
  /// Número do evento na agência (EVT001), dado pelo banco na criação.
  number           Int         @default(0)
  /// Contador do número dos itens (EVT001-CEN-023). Mantido por trigger.
  itemSeq          Int         @default(0) @map("item_seq")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  agency          Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  client          Client                @relation(fields: [agencyId, clientId], references: [agencyId, id], onDelete: Restrict)
  areas           Area[]
  teams           Team[]
  participants    Participant[]
  occurrences     Occurrence[]
  attachments     Attachment[]
  slaPolicies     SlaPolicy[]
  notifications   Notification[]
  invitations     Invitation[]
  serviceTypes    ServiceType[]
  costSheet       CostSheet?
  costSections    CostSection[]
  costItems       CostItem[]
  itemReceipts    ItemReceipt[]
  receiptPhotos   ReceiptPhoto[]
  briefings       Briefing[]
  dailyNotes      DailyNote[]
  functions       EventFunction[]
  activities      Activity[]
  clientViews     ClientView[]
  profiles        ParticipantProfile[]
  activityChecks  ActivityCheck[]
  quoteRequests   QuoteRequest[]
  supplierQuotes  SupplierQuote[]
  contracts       Contract[]
  supplierRatings SupplierRating[]
  milestones      EventMilestone[]
  tasks           EventTask[]
  arrivals        Arrival[]
  floorPlans      FloorPlan[]
  planPoints      PlanPoint[]
  planPhotos      PlanPointPhoto[]
  visits          TechnicalVisit[]
  visitPhotos     TechnicalVisitPhoto[]
  finances        EventFinances?
  briefing        EventBriefing?
  briefingFronts  EventBriefingFront[]
  documents       EventDocument[]
  lead            Participant?          @relation("EventLead", fields: [id, leadId], references: [eventId, id], onDelete: NoAction, onUpdate: NoAction, map: "events_lead_fkey")
  producer        Participant?          @relation("EventProducer", fields: [id, producerId], references: [eventId, id], onDelete: NoAction, onUpdate: NoAction, map: "events_producer_fkey")

  @@unique([agencyId, number])
  @@index([clientId])
  @@index([agencyId])
  @@index([status])
  @@map("events")
}

model Area {
  id          String       @id @default(uuid(7)) @db.Uuid
  eventId     String       @map("event_id") @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  teams        Team[]
  participants Participant[]
  occurrences  Occurrence[]
  planPoints   PlanPoint[]
  costItems    CostItem[]
  tasks        EventTask[]
  arrivals     Arrival[]

  /// Alvo das FKs compostas: garante que filhos apontem para área do MESMO evento.
  @@unique([eventId, id])
  @@index([eventId])
  @@map("areas")
}

model Team {
  id                  String       @id @default(uuid(7)) @db.Uuid
  eventId             String       @map("event_id") @db.Uuid
  areaId              String       @map("area_id") @db.Uuid
  name                String
  description         String?
  /// Líder da equipe: apenas informativo, não concede permissão.
  leaderParticipantId String?      @map("leader_participant_id") @db.Uuid
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(3)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  area         Area          @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: Restrict)
  leader       Participant?  @relation("TeamLeader", fields: [eventId, leaderParticipantId], references: [eventId, id], onDelete: NoAction)
  participants Participant[] @relation("ParticipantTeam")
  occurrences  Occurrence[]
  serviceTypes ServiceType[]
  planPoints   PlanPoint[]

  @@unique([eventId, areaId, id])
  @@index([eventId, areaId])
  @@map("teams")
}

/// A pessoa dentro de um evento. É daqui que vem o escopo de acesso.
model Participant {
  id            String          @id @default(uuid(7)) @db.Uuid
  eventId       String          @map("event_id") @db.Uuid
  /// Preenchido quando a pessoa aceita o convite / faz login com este e-mail.
  userId        String?         @map("user_id") @db.Uuid
  name          String
  email         String          @db.Citext
  phone         String?
  jobTitle      String?         @map("job_title")
  /// Empresa da pessoa (agência, fornecedor, freelancer...).
  company       String?
  /// Responsável direto: a quem a pessoa responde (texto livre).
  directManager String?         @map("direct_manager")
  role          ParticipantRole
  areaId        String?         @map("area_id") @db.Uuid
  teamId        String?         @map("team_id") @db.Uuid
  active        Boolean         @default(true)
  invitedAt     DateTime?       @map("invited_at") @db.Timestamptz(3)
  joinedAt      DateTime?       @map("joined_at") @db.Timestamptz(3)
  createdById   String?         @map("created_by") @db.Uuid
  /// Diretor de produção: participação criada sozinha pelo banco (veja Director).
  directorId    String?         @map("director_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(3)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user      User?     @relation("ParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  director  Director? @relation(fields: [directorId], references: [id], onDelete: Restrict)
  area      Area?     @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: NoAction)
  team      Team?     @relation("ParticipantTeam", fields: [eventId, areaId, teamId], references: [eventId, areaId, id], onDelete: NoAction)
  createdBy User?     @relation("ParticipantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  leadsTeams             Team[]              @relation("TeamLeader")
  responsibleOccurrences Occurrence[]        @relation("OccurrenceResponsible")
  invitations            Invitation[]
  serviceTypes           ServiceTypePerson[]
  costItemsToReceive     CostItem[]          @relation("CostItemReceiver")
  responsibleItems       CostItem[]          @relation("CostItemResponsible")
  milestones             EventMilestone[]    @relation("EventMilestoneResponsible")
  tasks                  EventTask[]         @relation("EventTaskResponsible")
  arrivals               Arrival[]           @relation("ArrivalResponsible")
  itemReceipts           ItemReceipt[]       @relation("ItemReceiptReceiver")
  briefing               Briefing?
  clientView             ClientView?
  profile                ParticipantProfile?
  ownActivities          Activity[]
  activityChecks         ActivityCheck[]
  quoteRequests          QuoteRequest[]
  planPoints             PlanPoint[]
  visits                 TechnicalVisit[]
  leadOf                 Event[]             @relation("EventLead")
  producerOf             Event[]             @relation("EventProducer")

  @@unique([eventId, email])
  @@unique([eventId, id])
  @@index([eventId, areaId, teamId])
  @@index([directorId])
  @@map("participants")
}

/// Diretor de produção da agência: o Admin cadastra uma vez e o banco o põe
/// como Gerente em todos os eventos abertos DA AGÊNCIA, inclusive os criados depois.
/// A função continua sendo por evento (uma participação em cada um).
model Director {
  id          String   @id @default(uuid(7)) @db.Uuid
  agencyId    String   @map("agency_id") @db.Uuid
  name        String
  email       String   @db.Citext
  phone       String?
  jobTitle    String?  @map("job_title")
  /// Preenchido quando o diretor aceita o convite; liga todas as participações.
  userId      String?  @map("user_id") @db.Uuid
  active      Boolean  @default(true)
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user         User?         @relation("DirectorUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("DirectorCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  participants Participant[]
  agencyAdmin  AgencyAdmin?

  @@unique([agencyId, email])
  @@unique([agencyId, userId])
  @@map("directors")
}

/// Convite de acesso. Guarda só o hash do token; o link é mostrado uma única vez.
model Invitation {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Restrict)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([participantId])
  @@map("invitations")
}

// ─────────────────────────── Ocorrências ───────────────────────────

model Occurrence {
  id                       String           @id @default(uuid(7)) @db.Uuid
  /// Número curto por evento (#142). Definido por trigger na inserção.
  number                   Int              @default(0)
  type                     OccurrenceType   @default(OCORRENCIA)
  /// Copiado do evento por trigger: nunca vem do navegador.
  clientId                 String           @map("client_id") @db.Uuid
  eventId                  String           @map("event_id") @db.Uuid
  areaId                   String           @map("area_id") @db.Uuid
  teamId                   String           @map("team_id") @db.Uuid
  responsibleParticipantId String?          @map("responsible_participant_id") @db.Uuid
  /// Tipo de atendimento (pré-produção). Sempre da mesma equipe do chamado.
  serviceTypeId            String?          @map("service_type_id") @db.Uuid
  title                    String
  process                  String?
  description              String?
  status                   OccurrenceStatus @default(PENDENTE)
  priority                 Priority         @default(NORMAL)
  openedAt                 DateTime         @default(now()) @map("opened_at") @db.Timestamptz(3)
  slaDueAt                 DateTime?        @map("sla_due_at") @db.Timestamptz(3)
  concludedAt              DateTime?        @map("concluded_at") @db.Timestamptz(3)
  concludedById            String?          @map("concluded_by") @db.Uuid
  /// concluded_at − opened_at, calculado por trigger.
  durationSeconds          Int?             @map("duration_seconds")
  slaBreached              Boolean?         @map("sla_breached")
  validationStatus         ValidationStatus @default(PENDENTE) @map("validation_status")
  validatedById            String?          @map("validated_by") @db.Uuid
  validatedAt              DateTime?        @map("validated_at") @db.Timestamptz(3)
  createdById              String           @map("created_by") @db.Uuid
  /// Controle de concorrência otimista (edições offline/simultâneas).
  version                  Int              @default(1)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  client        Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  area          Area               @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: Restrict)
  team          Team               @relation(fields: [eventId, areaId, teamId], references: [eventId, areaId, id], onDelete: Restrict)
  responsible   Participant?       @relation("OccurrenceResponsible", fields: [eventId, responsibleParticipantId], references: [eventId, id], onDelete: NoAction)
  concludedBy   User?              @relation("OccurrenceConcludedBy", fields: [concludedById], references: [id], onDelete: Restrict)
  validatedBy   User?              @relation("OccurrenceValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  createdBy     User               @relation("OccurrenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  serviceType   ServiceType?       @relation(fields: [eventId, areaId, teamId, serviceTypeId], references: [eventId, areaId, teamId, id], onDelete: NoAction)
  attachments   Attachment[]
  notifications Notification[]
  changes       OccurrenceChange[]

  @@unique([eventId, number])
  @@unique([eventId, id])
  @@index([eventId, status])
  @@index([eventId, areaId, status])
  @@index([eventId, teamId, status])
  @@index([responsibleParticipantId, status])
  @@index([clientId])
  @@index([serviceTypeId])
  @@map("occurrences")
}

model Attachment {
  id           String         @id @default(uuid(7)) @db.Uuid
  occurrenceId String         @map("occurrence_id") @db.Uuid
  eventId      String         @map("event_id") @db.Uuid
  storageKey   String         @unique @map("storage_key")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  width        Int?
  height       Int?
  sha256       String
  kind         AttachmentKind @default(EVIDENCIA)
  uploadedById String         @map("uploaded_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  occurrence Occurrence @relation(fields: [eventId, occurrenceId], references: [eventId, id], onDelete: Restrict)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  /// Re-sincronizar a mesma foto não duplica.
  @@unique([occurrenceId, sha256])
  @@index([occurrenceId])
  @@map("attachments")
}

model SlaPolicy {
  id            String   @id @default(uuid(7)) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  priority      Priority
  targetMinutes Int      @map("target_minutes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, priority])
  @@map("sla_policies")
}

// ─────────────────────── Auditoria e alertas ───────────────────────

/// Append-only. UPDATE/DELETE são bloqueados por trigger e por GRANT.
model AuditLog {
  id          BigInt      @id @default(autoincrement())
  occurredAt  DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?     @map("actor_user_id") @db.Uuid
  eventId     String?     @map("event_id") @db.Uuid
  entity      String
  entityId    String?     @map("entity_id") @db.Uuid
  action      AuditAction
  before      Json?
  after       Json?
  ip          String?     @db.Inet
  userAgent   String?     @map("user_agent")

  @@index([entity, entityId])
  @@index([eventId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_log")
}

model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  eventId      String?          @map("event_id") @db.Uuid
  occurrenceId String?          @map("occurrence_id") @db.Uuid
  type         NotificationType
  title        String
  body         String?
  /// Evita o mesmo aviso duas vezes para a mesma pessoa (ex.: "urgente:<chamado>").
  dedupeKey    String           @default(dbgenerated("(gen_random_uuid())::text")) @map("dedupe_key")
  /// Tela a abrir quando o aviso não é de um chamado (ex.: uma cotação).
  link         String?
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event?                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrence Occurrence?            @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Envio de um aviso por um canal externo (hoje só WhatsApp).
model NotificationDelivery {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String         @map("notification_id") @db.Uuid
  channel           String         @default("WHATSAPP")
  toPhone           String         @map("to_phone")
  template          String
  status            DeliveryStatus @default(PENDENTE)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  providerMessageId String?        @map("provider_message_id")
  lastError         String?        @map("last_error")
  /// Botão "Assumir" já usado: cada mensagem vale uma vez.
  actionUsedAt      DateTime?      @map("action_used_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@map("notification_deliveries")
}

/// Número de WhatsApp da pessoa e o aceite para receber avisos.
model WhatsappContact {
  userId    String    @id @map("user_id") @db.Uuid
  phone     String
  /// null = não quer receber avisos no WhatsApp.
  optedInAt DateTime? @map("opted_in_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_contacts")
}

/// Fila de mudanças nos chamados, gravada por trigger na mesma transação.
/// O despacho de avisos lê daqui (padrão "outbox").
model OccurrenceChange {
  id           BigInt    @id @default(autoincrement())
  occurrenceId String    @map("occurrence_id") @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  kind         String
  old          Json?
  new          Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(3)

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@map("occurrence_changes")
}

/// Fotos guardadas no próprio banco (STORAGE_DRIVER=database), para hospedagens
/// sem armazenamento de arquivos à parte, como o ambiente de teste. Só lê quem
/// enxerga a foto: a RLS confere a tabela attachments.
model StoredFile {
  key         String   @id
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  body        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("stored_files")
}

// ─────────────────────── Pré-produção ───────────────────────

/// Tipo de atendimento que uma equipe faz (ex.: "Troca de lâmpada"). O SLA
/// aprovado aqui vira o prazo dos chamados deste tipo.
model ServiceType {
  id          String    @id @default(uuid(7)) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  areaId      String    @map("area_id") @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  name        String
  description String?
  /// Prazo aprovado pelo gestor, em minutos. Vazio: vale o prazo da prioridade.
  slaMinutes  Int?      @map("sla_minutes")
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  team        Team                @relation(fields: [eventId, areaId, teamId], references: [eventId, areaId, id], onDelete: Restrict)
  createdBy   User                @relation("ServiceTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  proposals   SlaProposal[]
  people      ServiceTypePerson[]
  occurrences Occurrence[]

  @@unique([eventId, areaId, teamId, id])
  @@index([eventId, areaId, teamId])
  @@map("service_types")
}

/// SLA de um tipo: proposto por quem executa, aprovado/ajustado/recusado pelo
/// gestor com comentário. O histórico fica aqui.
model SlaProposal {
  id              String            @id @default(uuid(7)) @db.Uuid
  eventId         String            @map("event_id") @db.Uuid
  areaId          String            @map("area_id") @db.Uuid
  teamId          String            @map("team_id") @db.Uuid
  serviceTypeId   String            @map("service_type_id") @db.Uuid
  minutes         Int
  note            String?
  status          SlaProposalStatus @default(PENDENTE)
  approvedMinutes Int?              @map("approved_minutes")
  feedback        String?
  proposedById    String            @map("proposed_by") @db.Uuid
  reviewedById    String?           @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceType ServiceType @relation(fields: [eventId, areaId, teamId, serviceTypeId], references: [eventId, areaId, teamId, id], onDelete: Restrict)
  proposedBy  User        @relation("SlaProposalProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("SlaProposalReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([serviceTypeId, createdAt])
  @@index([eventId, status])
  @@map("sla_proposals")
}

/// Quem faz cada tipo de atendimento (a planilha "quem faz o quê").
model ServiceTypePerson {
  eventId       String   @map("event_id") @db.Uuid
  areaId        String   @map("area_id") @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  serviceTypeId String   @map("service_type_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceType ServiceType @relation(fields: [eventId, areaId, teamId, serviceTypeId], references: [eventId, areaId, teamId, id], onDelete: Restrict)
  participant Participant @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Restrict)

  @@id([serviceTypeId, participantId])
  @@index([eventId, participantId])
  @@map("service_type_people")
}

// ─────────────────── Pré-produção: planilha de custos ───────────────────

/// Cabeçalho e percentuais do orçamento do evento (um por evento).
/// Totais seguem a matriz: honorários sobre o subtotal de fornecedores;
/// encargos "por dentro" (valor / (1 - %) - valor) na fatura e na NF.
model CostSheet {
  eventId            String   @id @map("event_id") @db.Uuid
  title              String?
  clientName         String?  @map("client_name")
  projectName        String?  @map("project_name")
  period             String?
  clientPaymentTerms String?  @map("client_payment_terms")
  author             String?
  feePct             Decimal  @default(15) @map("fee_pct") @db.Decimal(5, 2)
  invoiceTaxPct      Decimal  @default(9.5) @map("invoice_tax_pct") @db.Decimal(5, 2)
  nfTaxPct           Decimal  @default(17.5) @map("nf_tax_pct") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("cost_sheets")
}

/// Seção do orçamento (Estrutura, Cenografia, A&B...).
model CostSection {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  position  Int
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items CostItem[]

  @@unique([eventId, id])
  @@index([eventId, position])
  @@map("cost_sections")
}

/// Item do orçamento: subtotal = valor unitário × quantidade × frequência
/// (sem frequência, conta 1). Opcional aparece mas fica fora dos totais.
/// Sem valor unitário = "a definir": fica fora dos totais até ser preenchido.
model CostItem {
  id              String        @id @default(uuid(7)) @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  sectionId       String        @map("section_id") @db.Uuid
  position        Int
  name            String
  description     String?
  paymentTerms    String?       @map("payment_terms")
  unitValue       Decimal?      @map("unit_value") @db.Decimal(14, 2)
  quantity        Decimal       @db.Decimal(12, 3)
  frequency       Decimal?      @db.Decimal(12, 3)
  optional        Boolean       @default(false)
  billing         CostBilling   @default(FATURA)
  /// Quem recebe o item no campo (escolhido pelo Gerente).
  receiverId      String?       @map("receiver_id") @db.Uuid
  /// Item do evento (fase 2): número no evento (código EVT001-CEN-023), dado pelo banco.
  number          Int           @default(0)
  areaId          String?       @map("area_id") @db.Uuid
  category        ItemCategory?
  /// Centro de custo escolhido pelo diretor. Vazio: vem da categoria.
  costCenter      CostCenter?   @map("cost_center")
  unit            String?
  responsibleId   String?       @map("responsible_id") @db.Uuid
  neededOn        DateTime?     @map("needed_on") @db.Date
  location        String?
  status          ItemStatus    @default(A_DEFINIR)
  notes           String?
  /// Os 4 valores (fase 2B). Estimado = unitValue × quantidade × frequência.
  /// Cotado digitado (vale só quando o item não tem orçamento na cotação).
  quotedValue     Decimal?      @map("quoted_value") @db.Decimal(14, 2)
  /// Contratado e Realizado (totais do item): só o diretor de produção.
  contractedValue Decimal?      @map("contracted_value") @db.Decimal(14, 2)
  actualValue     Decimal?      @map("actual_value") @db.Decimal(14, 2)
  /// Cronograma (fase 4A): o item que precisa ficar pronto antes deste.
  dependsOnId     String?       @map("depends_on_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  section      CostSection    @relation(fields: [eventId, sectionId], references: [eventId, id], onDelete: Cascade)
  receiver     Participant?   @relation("CostItemReceiver", fields: [eventId, receiverId], references: [eventId, id], onDelete: NoAction)
  responsible  Participant?   @relation("CostItemResponsible", fields: [eventId, responsibleId], references: [eventId, id], onDelete: NoAction, map: "cost_items_responsible_fkey")
  area         Area?          @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: NoAction, map: "cost_items_area_fkey")
  receipt      ItemReceipt?
  dependsOn    CostItem?      @relation("CostItemDependsOn", fields: [eventId, dependsOnId], references: [eventId, id], onDelete: NoAction, onUpdate: NoAction, map: "cost_items_depends_on_fkey")
  dependents   CostItem[]     @relation("CostItemDependsOn")
  arrivalItems ArrivalItem[]
  quotes       QuoteRequest[]

  @@unique([eventId, number])
  @@unique([eventId, id])
  @@index([eventId, sectionId, position])
  @@index([eventId, status])
  @@map("cost_items")
}

/// Status do Item do evento, na ordem do fluxo (o banco compara por esta ordem).
enum ItemStatus {
  A_DEFINIR
  EM_COTACAO
  COTACAO_RECEBIDA
  EM_APROVACAO
  APROVADO
  CONTRATADO
  EM_PRODUCAO
  PRONTO
  EM_TRANSPORTE
  NO_LOCAL
  MONTADO
  CONFERIDO
  FINALIZADO

  @@map("item_status")
}

/// As 18 categorias do orçamento (roadmap do Abu).
enum ItemCategory {
  INFRAESTRUTURA
  CENOGRAFIA
  TECNICA
  AUDIOVISUAL
  ILUMINACAO
  MOBILIARIO
  COMUNICACAO_VISUAL
  RECURSOS_HUMANOS
  SEGURANCA
  LIMPEZA
  TRANSPORTE
  HOSPEDAGEM
  ALIMENTACAO
  LOGISTICA
  LOCACAO
  TAXAS
  PRODUCAO
  CONTINGENCIA

  @@map("item_category")
}

/// Os 8 centros de custo (01 INFRA ... 08 ADMINISTRATIVO).
enum CostCenter {
  INFRA
  CENO
  TECNICA
  OPERACAO
  LOGISTICA
  STAFF
  PRODUCAO
  ADMINISTRATIVO

  @@map("cost_center")
}

// ─────────────── Itens no campo: recebimento (sem valores) ───────────────

/// O que vai para o campo quando o Gerente "envia": cópia do item SEM valores
/// (nome, descritivo, quantidade, seção) para quem recebe, e a conferência
/// que essa pessoa faz. Os preços ficam só em cost_items (Pré-produção).
model ItemReceipt {
  id                  String        @id @default(uuid(7)) @db.Uuid
  eventId             String        @map("event_id") @db.Uuid
  costItemId          String        @unique @map("cost_item_id") @db.Uuid
  receiverId          String        @map("receiver_id") @db.Uuid
  sectionName         String        @map("section_name")
  /// Ordem da planilha (seção, depois item) no último envio.
  position            Int           @default(0)
  name                String
  description         String?
  quantity            Decimal       @db.Decimal(12, 3)
  unit                String?
  location            String?
  status              ReceiptStatus @default(PENDENTE)
  receivedQuantity    Decimal?      @map("received_quantity") @db.Decimal(12, 3)
  receivedDescription String?       @map("received_description")
  note                String?
  receivedAt          DateTime?     @map("received_at") @db.Timestamptz(3)
  receivedById        String?       @map("received_by") @db.Uuid
  sentAt              DateTime      @default(now()) @map("sent_at") @db.Timestamptz(3)
  sentById            String        @map("sent_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  costItem CostItem       @relation(fields: [eventId, costItemId], references: [eventId, id], onDelete: Restrict)
  receiver Participant    @relation("ItemReceiptReceiver", fields: [eventId, receiverId], references: [eventId, id], onDelete: NoAction)
  photos   ReceiptPhoto[]

  @@unique([eventId, id])
  @@unique([eventId, costItemId])
  @@index([eventId, receiverId])
  @@map("item_receipts")
}

/// Foto da conferência (ex.: o item que chegou diferente).
model ReceiptPhoto {
  id           String   @id @default(uuid(7)) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  receiptId    String   @map("receipt_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  receipt ItemReceipt @relation(fields: [eventId, receiptId], references: [eventId, id], onDelete: Cascade)

  @@unique([receiptId, sha256])
  @@map("receipt_photos")
}

// ─────────────── Pré-produção: briefing e relatório diário ───────────────

/// Briefing de uma pessoa do campo: função, posto, horários e o que ela faz.
/// Escrito pela Pré-produção; a pessoa lê o seu e confirma ("Li e entendi").
/// Mudou o texto depois de lido: version sobe e a leitura vale de novo.
model Briefing {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  participantId String    @unique @map("participant_id") @db.Uuid
  /// Função. Vazio: usa o cargo da pessoa na equipe.
  roleText      String?   @map("role_text")
  post          String?
  schedule      String?
  duties        String?
  notes         String?
  /// Sobe a cada mudança no texto (gatilho no banco).
  version       Int       @default(1)
  /// Versão que a pessoa confirmou que leu (0 = ainda não leu).
  readVersion   Int       @default(0) @map("read_version")
  readAt        DateTime? @map("read_at") @db.Timestamptz(3)
  updatedById   String    @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Restrict)
  updatedBy   User        @relation("BriefingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([eventId, participantId])
  @@map("briefings")
}

/// Observações do gestor sobre um dia do evento (vão no relatório diário).
model DailyNote {
  eventId     String   @map("event_id") @db.Uuid
  day         DateTime @db.Date
  body        String
  updatedById String   @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  updatedBy User  @relation("DailyNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@id([eventId, day])
  @@map("daily_notes")
}

/// Função do evento (Pré-produção › Funções): escrita uma vez, aplicada a
/// muitas pessoas. As atividades da função valem para todos que a têm.
model EventFunction {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  description String?
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy  User                 @relation("EventFunctionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activities Activity[]
  profiles   ParticipantProfile[]

  @@unique([eventId, id])
  @@map("event_functions")
}

/// Atividade com dia e horário: da função (vale para todos com ela) ou de
/// uma pessoa só. Exatamente um dos dois.
model Activity {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  functionId    String?   @map("function_id") @db.Uuid
  participantId String?   @map("participant_id") @db.Uuid
  title         String
  day           DateTime? @db.Date
  /// "HH:MM", no fuso do evento.
  startTime     String?   @map("start_time")
  endTime       String?   @map("end_time")
  place         String?
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  function    EventFunction?  @relation(fields: [eventId, functionId], references: [eventId, id], onDelete: Cascade)
  participant Participant?    @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Restrict)
  createdBy   User            @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  checks      ActivityCheck[]

  @@unique([eventId, id])
  @@index([eventId, functionId])
  @@index([eventId, participantId])
  @@map("activities")
}

/// "Feito": só a própria pessoa marca, e só nas atividades dela.
model ActivityCheck {
  activityId    String   @map("activity_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  doneAt        DateTime @default(now()) @map("done_at") @db.Timestamptz(3)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  activity    Activity    @relation(fields: [eventId, activityId], references: [eventId, id], onDelete: Cascade)
  participant Participant @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Restrict)

  @@id([activityId, participantId])
  @@index([eventId, participantId])
  @@map("activity_checks")
}

/// Ficha da pessoa no evento: a função e os dados para a produção. Só a
/// Pré-produção e a própria pessoa veem; a pessoa não muda a própria função.
model ParticipantProfile {
  participantId  String   @id @map("participant_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  functionId     String?  @map("function_id") @db.Uuid
  document       String?
  uniformSize    String?  @map("uniform_size")
  dietary        String?
  emergencyName  String?  @map("emergency_name")
  emergencyPhone String?  @map("emergency_phone")
  updatedById    String   @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant Participant    @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Restrict)
  function    EventFunction? @relation(fields: [eventId, functionId], references: [eventId, id], onDelete: Restrict)
  updatedBy   User           @relation("ParticipantProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([eventId, participantId])
  @@index([eventId, functionId])
  @@map("participant_profiles")
}

// ─────────────── Pré-produção: cotação com fornecedores ───────────────

/// Andamento de cada proposta da cotação (fase 3C).
enum ProposalStatus {
  /// Pedida ao fornecedor, ainda sem valor.
  SOLICITADA
  RECEBIDA
  EM_NEGOCIACAO
  /// A escolhida pelo diretor (só quando a cotação fecha).
  APROVADA
  /// As outras, quando a cotação fecha.
  RECUSADA
  /// O fornecedor desistiu ou a proposta saiu da disputa.
  CANCELADA

  @@map("proposal_status")
}

enum QuoteStatus {
  /// Criada: o descritivo ainda não saiu para os fornecedores.
  ABERTA
  /// Enviada aos fornecedores; o gestor define o prazo para os orçamentos.
  ENVIADA
  /// O gestor escolheu um orçamento.
  FECHADA
  CANCELADA

  @@map("quote_status")
}

/// Pedido de cotação: o descritivo do que se cota (o "briefing" que vai por
/// e-mail aos fornecedores), quem cuida e o prazo que o gestor define depois
/// do envio. Só a Pré-produção vê (valores nunca vão para o campo).
model QuoteRequest {
  id            String      @id @default(uuid(7)) @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  title         String
  briefing      String
  /// Quem pede os orçamentos (Gerente ou Pré-produtor do evento).
  responsibleId String      @map("responsible_id") @db.Uuid
  /// Item da planilha de custos que esta cotação vai preencher (opcional).
  costItemId    String?     @map("cost_item_id") @db.Uuid
  status        QuoteStatus @default(ABERTA)
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(3)
  sentById      String?     @map("sent_by") @db.Uuid
  /// Prazo definido pelo gestor (em minutos) e até quando vale.
  slaMinutes    Int?        @map("sla_minutes")
  dueAt         DateTime?   @map("due_at") @db.Timestamptz(3)
  slaSetAt      DateTime?   @map("sla_set_at") @db.Timestamptz(3)
  slaSetById    String?     @map("sla_set_by") @db.Uuid
  /// Quando chegou o terceiro orçamento (volta a vazio se um sair).
  completedAt   DateTime?   @map("completed_at") @db.Timestamptz(3)
  chosenQuoteId String?     @map("chosen_quote_id") @db.Uuid
  chosenReason  String?     @map("chosen_reason")
  closedAt      DateTime?   @map("closed_at") @db.Timestamptz(3)
  closedById    String?     @map("closed_by") @db.Uuid
  createdById   String      @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  responsible Participant     @relation(fields: [eventId, responsibleId], references: [eventId, id], onDelete: Restrict)
  costItem    CostItem?       @relation(fields: [eventId, costItemId], references: [eventId, id], onDelete: SetNull)
  chosen      SupplierQuote?  @relation("QuoteChosen", fields: [id, chosenQuoteId], references: [requestId, id], onDelete: NoAction)
  createdBy   User            @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  slaSetBy    User?           @relation("QuoteSlaSetBy", fields: [slaSetById], references: [id], onDelete: Restrict)
  closedBy    User?           @relation("QuoteClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  quotes      SupplierQuote[] @relation("QuoteQuotes")

  @@unique([eventId, id])
  @@index([eventId, status])
  @@map("quote_requests")
}

/// Um dos (até) 3 orçamentos recebidos, com os dados do fornecedor e o arquivo.
model SupplierQuote {
  id              String         @id @default(uuid(7)) @db.Uuid
  eventId         String         @map("event_id") @db.Uuid
  requestId       String         @map("request_id") @db.Uuid
  /// Fornecedor do cadastro da agência. CNPJ e razão social aqui ficam como estavam no orçamento.
  supplierId      String         @map("supplier_id") @db.Uuid
  /// 1, 2 ou 3.
  position        Int
  cnpj            String
  companyName     String         @map("company_name")
  phone           String
  email           String         @db.Citext
  contactName     String         @map("contact_name")
  /// Valor recebido do fornecedor (vazio enquanto Solicitada). Fica guardado mesmo depois da negociação.
  totalValue      Decimal?       @map("total_value") @db.Decimal(14, 2)
  status          ProposalStatus @default(RECEBIDA)
  /// Valor negociado pelo diretor; quando existe, é ele que vale.
  negotiatedValue Decimal?       @map("negotiated_value") @db.Decimal(14, 2)
  negotiationNote String?        @map("negotiation_note")
  negotiatedAt    DateTime?      @map("negotiated_at") @db.Timestamptz(3)
  negotiatedById  String?        @map("negotiated_by") @db.Uuid
  paymentTerms    String?        @map("payment_terms")
  notes           String?
  fileKey         String?        @unique @map("file_key")
  fileName        String?        @map("file_name")
  fileMime        String?        @map("file_mime")
  fileSize        Int?           @map("file_size")
  createdById     String         @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  request       QuoteRequest   @relation("QuoteQuotes", fields: [eventId, requestId], references: [eventId, id], onDelete: Restrict)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("SupplierQuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  negotiatedBy  User?          @relation("SupplierQuoteNegotiatedBy", fields: [negotiatedById], references: [id], onDelete: Restrict)
  chosenBy      QuoteRequest[] @relation("QuoteChosen")
  contractItems ContractItem[]

  @@unique([requestId, position])
  @@unique([requestId, id])
  @@unique([eventId, id])
  @@index([supplierId])
  @@map("supplier_quotes")
}

// ─────────────────────── Planta do evento (Gestão de campo) ───────────────────────
// O Gerente envia a planta (imagem; PDF vira imagem no navegador) e marca nela
// onde acontece cada etapa de montagem ou de finalização. Todos do campo veem.

enum PlanPointKind {
  MONTAGEM
  FINALIZACAO

  @@map("plan_point_kind")
}

/// "Atrasado" não é guardado: sai do horário previsto (veja pointLate).
enum PlanPointStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO

  @@map("plan_point_status")
}

model FloorPlan {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  position    Int      @default(0)
  storageKey  String   @unique @map("storage_key")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  sha256      String
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event  Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  points PlanPoint[]

  @@unique([eventId, id])
  @@index([eventId])
  @@map("floor_plans")
}

/// Uma etapa marcada na planta. x e y em % da imagem (0 a 100), a partir do canto de cima à esquerda.
model PlanPoint {
  id            String          @id @default(uuid(7)) @db.Uuid
  eventId       String          @map("event_id") @db.Uuid
  planId        String          @map("plan_id") @db.Uuid
  x             Float
  y             Float
  name          String
  description   String?
  kind          PlanPointKind
  /// Sem área = só o Gerente mexe. Com área, o Head dela também.
  areaId        String?         @map("area_id") @db.Uuid
  teamId        String?         @map("team_id") @db.Uuid
  responsibleId String?         @map("responsible_id") @db.Uuid
  startsAt      DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime?       @map("ends_at") @db.Timestamptz(3)
  status        PlanPointStatus @default(NAO_INICIADO)
  startedAt     DateTime?       @map("started_at") @db.Timestamptz(3)
  startedById   String?         @map("started_by") @db.Uuid
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz(3)
  finishedById  String?         @map("finished_by") @db.Uuid
  /// Observação de quem trabalhou na etapa (ao concluir, por exemplo).
  note          String?
  createdById   String          @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  plan        FloorPlan        @relation(fields: [eventId, planId], references: [eventId, id], onDelete: Cascade)
  area        Area?            @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: NoAction)
  team        Team?            @relation(fields: [eventId, areaId, teamId], references: [eventId, areaId, id], onDelete: NoAction)
  responsible Participant?     @relation(fields: [eventId, responsibleId], references: [eventId, id], onDelete: NoAction)
  photos      PlanPointPhoto[]

  @@unique([eventId, id])
  @@index([eventId, planId])
  @@map("plan_points")
}

model PlanPointPhoto {
  id           String   @id @default(uuid(7)) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  pointId      String   @map("point_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  point PlanPoint @relation(fields: [eventId, pointId], references: [eventId, id], onDelete: Cascade)

  @@unique([pointId, sha256])
  @@map("plan_point_photos")
}

/// Visita técnica da Pré-produção ao local do evento: quem vai (Gerente ou
/// Pré-produtor), data e horário, e os EPIs necessários. Só a Pré-produção vê.
model TechnicalVisit {
  id               String      @id @default(uuid(7)) @db.Uuid
  eventId          String      @map("event_id") @db.Uuid
  title            String
  place            String?
  scheduledAt      DateTime    @map("scheduled_at") @db.Timestamptz(3)
  responsibleId    String      @map("responsible_id") @db.Uuid
  /// EPIs necessários, pelos nomes da lista do app (src/modules/visits/ppe.ts).
  ppe              String[]    @default([])
  /// Outros EPIs ou cuidados, em texto livre.
  ppeOther         String?     @map("ppe_other")
  notes            String?
  /// Relatório da visita: o briefing do lugar, preenchido no local.
  address          String?
  people           String?
  accessText       String?     @map("access_text")
  powerText        String?     @map("power_text")
  internetText     String?     @map("internet_text")
  facilitiesText   String?     @map("facilities_text")
  restrictionsText String?     @map("restrictions_text")
  contactsText     String?     @map("contacts_text")
  observations     String?
  /// Para concluir, pelo menos 10 fotos; concluída, fica travada até reabrir.
  status           VisitStatus @default(ABERTA)
  concludedAt      DateTime?   @map("concluded_at") @db.Timestamptz(3)
  createdById      String      @map("created_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  responsible Participant           @relation(fields: [eventId, responsibleId], references: [eventId, id], onDelete: Restrict)
  createdBy   User                  @relation("TechnicalVisitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  photos      TechnicalVisitPhoto[]

  @@unique([eventId, id])
  @@index([eventId, scheduledAt])
  @@map("technical_visits")
}

enum VisitStatus {
  ABERTA
  CONCLUIDA

  @@map("visit_status")
}

/// Foto do relatório da visita técnica, com legenda (no máximo 40 por visita).
model TechnicalVisitPhoto {
  id           String   @id @default(uuid(7)) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  visitId      String   @map("visit_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  caption      String?
  position     Int      @default(0)
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  visit TechnicalVisit @relation(fields: [eventId, visitId], references: [eventId, id], onDelete: Cascade)

  @@unique([visitId, sha256])
  @@index([visitId, position])
  @@map("technical_visit_photos")
}

/// O que o Cliente vê no evento. Ele só olha; quem libera cada parte é o
/// Gerente do evento (diretor ou executivo) ou o Admin da agência.
model ClientView {
  participantId String   @id @map("participant_id") @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  /// Planilha de custos, com valores.
  costs         Boolean  @default(false)
  /// Áreas, equipes e pessoas (sem a ficha).
  team          Boolean  @default(false)
  /// Chamados e planta do evento.
  progress      Boolean  @default(false)
  updatedById   String   @map("updated_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Cascade)
  updatedBy   User        @relation("ClientViewUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([eventId, participantId])
  @@map("client_views")
}

/// Valores da ficha do evento: orçamento aprovado e centro de custo. Tabela à
/// parte para o campo nunca ler (só a Pré-produção e o Admin).
model EventFinances {
  eventId        String   @id @map("event_id") @db.Uuid
  approvedBudget Decimal? @map("approved_budget") @db.Decimal(14, 2)
  costCenter     String?  @map("cost_center")
  updatedById    String   @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_finances")
}

/// Briefing do evento (Pré-produção): o que o cliente pediu, em quatro blocos.
/// Nome, tipo, público estimado, local e endereço vêm da ficha do evento.
model EventBriefing {
  eventId           String   @id @map("event_id") @db.Uuid
  clientCompany     String?  @map("client_company")
  clientAgency      String?  @map("client_agency")
  clientContact     String?  @map("client_contact")
  clientResponsible String?  @map("client_responsible")
  objective         String?
  concept           String?
  audienceProfile   String?  @map("audience_profile")
  venueContacts     String?  @map("venue_contacts")
  allowedHours      String?  @map("allowed_hours")
  venueRules        String?  @map("venue_rules")
  updatedById       String   @map("updated_by") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_briefings")
}

/// As 13 frentes de estrutura do briefing.
enum BriefingFront {
  CENOGRAFIA
  INFRAESTRUTURA
  AUDIO
  VIDEO
  ILUMINACAO
  MOBILIARIO
  CREDENCIAMENTO
  SEGURANCA
  LIMPEZA
  ALIMENTACAO
  STAFF
  TRANSPORTE
  LOGISTICA

  @@map("briefing_front")
}

/// Cada frente: precisa (sim, não; sem linha ou nulo = a definir) e observação.
model EventBriefingFront {
  eventId String        @map("event_id") @db.Uuid
  front   BriefingFront
  needed  Boolean?
  notes   String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, front])
  @@map("event_briefing_fronts")
}

/// Categorias da central de documentos do evento.
enum DocumentCategory {
  BRIEFING
  PLANTA
  MEMORIAL
  MANUAL
  IDENTIDADE_VISUAL
  PROJETO_3D
  ORCAMENTO_CLIENTE
  CONTRATO
  PEDIDO
  NOTA_FISCAL
  ART_RRT
  LAUDO
  SEGURO
  CRONOGRAMA
  MAPA
  CHECKLIST
  OUTRO

  @@map("document_category")
}

/// Documento do evento (Pré-produção). O gestor pode liberar para o campo ler.
model EventDocument {
  id             String           @id @default(uuid(7)) @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  category       DocumentCategory
  title          String
  fileName       String           @map("file_name")
  mimeType       String           @map("mime_type")
  sizeBytes      Int              @map("size_bytes")
  sha256         String
  storageKey     String           @unique @map("storage_key")
  visibleToField Boolean          @default(false) @map("visible_to_field")
  uploadedById   String           @map("uploaded_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("EventDocumentUploadedBy", fields: [uploadedById], references: [id])
  contract   Contract?

  @@unique([eventId, sha256])
  @@index([eventId, category])
  @@map("event_documents")
}

/// Bonificação que o fornecedor dá à agência: percentual ou valor.
enum BonusKind {
  PERCENTUAL
  VALOR

  @@map("bonus_kind")
}

/// Cadastro de fornecedores da agência (um por CNPJ), usado em todos os eventos
/// dela. A Pré-produção cadastra e edita; só o diretor arquiva. Nunca é apagado.
model Supplier {
  id          String         @id @default(uuid(7)) @db.Uuid
  agencyId    String         @map("agency_id") @db.Uuid
  cnpj        String
  companyName String         @map("company_name")
  tradeName   String?        @map("trade_name")
  contactName String?        @map("contact_name")
  phone       String?
  whatsapp    String?
  email       String?        @db.Citext
  city        String?
  /// UF, duas letras.
  state       String?
  /// Região de atendimento, em texto.
  region      String?
  categories  ItemCategory[] @default([])
  specialty   String?
  team        String?
  equipment   String?
  capacity    String?
  notes       String?
  archivedAt  DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdById String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency    Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdBy User             @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  bonus     SupplierBonus?
  quotes    SupplierQuote[]
  contracts Contract[]
  ratings   SupplierRating[]
  arrivals  Arrival[]

  @@unique([agencyId, cnpj])
  @@index([agencyId, companyName])
  @@map("suppliers")
}

/// Bonificação do fornecedor. Só o diretor preenche; o diretor e o Head da área
/// em que ele foi contratado veem (RLS própria, separada do cadastro).
model SupplierBonus {
  supplierId  String    @id @map("supplier_id") @db.Uuid
  kind        BonusKind
  value       Decimal   @db.Decimal(14, 2)
  notes       String?
  updatedById String    @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  updatedBy User     @relation("SupplierBonusUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("supplier_bonuses")
}

// ─────────────────────── Contratos (Pré-produção, fase 3C) ───────────────────────
// Um contrato por fornecedor por evento, com as propostas aprovadas dele como
// itens. O pré-produtor monta o rascunho e anexa o PDF (que também fica em
// Documentos como CONTRATO, sem ir para o campo). Só o diretor (gestor do
// evento) muda valor, assina ou cancela. O campo e o cliente não veem.

enum ContractStatus {
  RASCUNHO
  ENVIADO
  ASSINADO
  CANCELADO

  @@map("contract_status")
}

model Contract {
  id            String         @id @default(uuid(7)) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  supplierId    String         @map("supplier_id") @db.Uuid
  /// Número do contrato no evento (1, 2, 3...).
  number        Int
  status        ContractStatus @default(RASCUNHO)
  paymentTerms  String?        @map("payment_terms")
  /// Datas de entrega, montagem e retirada, em texto.
  deliveryNotes String?        @map("delivery_notes")
  notes         String?
  /// O PDF do contrato, guardado em Documentos (categoria CONTRATO).
  documentId    String?        @unique @map("document_id") @db.Uuid
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(3)
  signedOn      DateTime?      @map("signed_on") @db.Date
  signedById    String?        @map("signed_by") @db.Uuid
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?        @map("cancel_reason")
  cancelledById String?        @map("cancelled_by") @db.Uuid
  createdById   String         @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  document    EventDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy   User           @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  signedBy    User?          @relation("ContractSignedBy", fields: [signedById], references: [id], onDelete: Restrict)
  cancelledBy User?          @relation("ContractCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  items       ContractItem[]
  arrival     Arrival?

  @@unique([eventId, number])
  @@index([supplierId])
  @@map("contracts")
}

model ContractItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  /// A proposta aprovada que este item contrata.
  quoteId    String   @map("quote_id") @db.Uuid
  /// Começa com o valor da proposta (o negociado, se houver); só o diretor muda.
  value      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  quote    SupplierQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([contractId, quoteId])
  @@index([quoteId])
  @@map("contract_items")
}

/// Avaliação do fornecedor num evento (fase 3D): o diretor e o Head da área
/// dão de 0 a 10 em 6 critérios quando o evento chega no Fechamento, para quem
/// teve contrato assinado. Uma por pessoa por fornecedor no evento; cada um
/// corrige a sua. A Pré-produção só vê as médias (app.supplier_rating_summary).
model SupplierRating {
  id             String   @id @default(uuid(7)) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  quality        Int      @db.SmallInt
  deadline       Int      @db.SmallInt
  service        Int      @db.SmallInt
  cost           Int      @db.SmallInt
  flexibility    Int      @db.SmallInt
  problemSolving Int      @map("problem_solving") @db.SmallInt
  comment        String?
  ratedById      String   @map("rated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  ratedBy  User     @relation(fields: [ratedById], references: [id], onDelete: Restrict)

  @@unique([eventId, supplierId, ratedById])
  @@index([supplierId])
  @@map("supplier_ratings")
}

/// Marco do cronograma do evento (fase 4A): T-30 a T0, gerados pela data do
/// evento e editáveis pela Pré-produção. Feito guarda quem marcou e quando.
model EventMilestone {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  title         String
  dueOn         DateTime  @map("due_on") @db.Date
  responsibleId String?   @map("responsible_id") @db.Uuid
  doneAt        DateTime? @map("done_at") @db.Timestamptz(3)
  doneById      String?   @map("done_by") @db.Uuid
  /// Vazio nos marcos padrão, que o app cria sozinho.
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  responsible Participant? @relation("EventMilestoneResponsible", fields: [eventId, responsibleId], references: [eventId, id], onDelete: NoAction, onUpdate: NoAction, map: "event_milestones_responsible_fkey")
  doneBy      User?        @relation("EventMilestoneDoneBy", fields: [doneById], references: [id], onDelete: Restrict)
  createdBy   User?        @relation("EventMilestoneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([eventId, dueOn])
  @@map("event_milestones")
}

/// Pendência criada à mão na Central de pendências (fase 4B). As outras
/// pendências o app junta do cronograma, itens, cotações, contratos e
/// avaliações. Só a Pré-produção vê.
model EventTask {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  title         String
  dueOn         DateTime? @map("due_on") @db.Date
  areaId        String?   @map("area_id") @db.Uuid
  responsibleId String?   @map("responsible_id") @db.Uuid
  doneAt        DateTime? @map("done_at") @db.Timestamptz(3)
  doneById      String?   @map("done_by") @db.Uuid
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  area        Area?        @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: NoAction, onUpdate: NoAction, map: "event_tasks_area_fkey")
  responsible Participant? @relation("EventTaskResponsible", fields: [eventId, responsibleId], references: [eventId, id], onDelete: NoAction, onUpdate: NoAction, map: "event_tasks_responsible_fkey")
  doneBy      User?        @relation("EventTaskDoneBy", fields: [doneById], references: [id], onDelete: Restrict)
  createdBy   User         @relation("EventTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([eventId, dueOn])
  @@map("event_tasks")
}

// ───────────────────────── Mapa de montagem (fase 5A) ─────────────────────────
// Cada chegada de fornecedor na montagem: horário, veículo, doca, área,
// responsável e status. Nasce do contrato assinado; a Pré-produção completa e o
// campo (Gerente, Head da área, responsável) marca chegou, montando, montado e
// retirado. Nada de valores: o fornecedor e os itens ficam copiados como texto.

enum ArrivalStatus {
  AGENDADO
  CHEGOU
  MONTANDO
  MONTADO
  RETIRADO

  @@map("arrival_status")
}

model Arrival {
  id            String        @id @default(uuid(7)) @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  /// O contrato que criou esta chegada (uma por contrato).
  contractId    String?       @unique @map("contract_id") @db.Uuid
  supplierId    String?       @map("supplier_id") @db.Uuid
  supplierName  String        @map("supplier_name")
  scheduledAt   DateTime?     @map("scheduled_at") @db.Timestamptz(3)
  /// Até quando vai a montagem (previsto).
  endsAt        DateTime?     @map("ends_at") @db.Timestamptz(3)
  vehicle       String?
  plate         String?
  driver        String?
  driverPhone   String?       @map("driver_phone")
  /// Doca ou portão de entrada.
  dock          String?
  areaId        String?       @map("area_id") @db.Uuid
  responsibleId String?       @map("responsible_id") @db.Uuid
  notes         String?
  status        ArrivalStatus @default(AGENDADO)
  arrivedAt     DateTime?     @map("arrived_at") @db.Timestamptz(3)
  arrivedById   String?       @map("arrived_by") @db.Uuid
  statusAt      DateTime?     @map("status_at") @db.Timestamptz(3)
  statusById    String?       @map("status_by") @db.Uuid
  /// Vazio nas que o app cria do contrato.
  createdById   String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  contract    Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  supplier    Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  area        Area?         @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: NoAction, onUpdate: NoAction, map: "arrivals_area_fkey")
  responsible Participant?  @relation("ArrivalResponsible", fields: [eventId, responsibleId], references: [eventId, id], onDelete: NoAction, onUpdate: NoAction, map: "arrivals_responsible_fkey")
  arrivedBy   User?         @relation("ArrivalArrivedBy", fields: [arrivedById], references: [id], onDelete: Restrict)
  statusBy    User?         @relation("ArrivalStatusBy", fields: [statusById], references: [id], onDelete: Restrict)
  createdBy   User?         @relation("ArrivalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       ArrivalItem[]

  @@index([eventId, scheduledAt])
  @@map("arrivals")
}

/// Item que chega nesta entrega (nome e quantidade copiados, sem valores).
model ArrivalItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  arrivalId  String   @map("arrival_id") @db.Uuid
  costItemId String?  @map("cost_item_id") @db.Uuid
  name       String
  quantity   Decimal? @db.Decimal(12, 3)
  unit       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  arrival  Arrival   @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  costItem CostItem? @relation(fields: [costItemId], references: [id], onDelete: SetNull)

  @@unique([arrivalId, costItemId])
  @@map("arrival_items")
}
