// CORE 360 — schema do banco.
// Regras que o Prisma não expressa (CHECKs, índices parciais, triggers,
// auditoria imutável e, na etapa 4, RLS) ficam em SQL nas migrations.
// Proposta de referência: docs/01-arquitetura-e-modelo-de-dados.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum EventStatus {
  PLANEJAMENTO
  PRE_PRODUCAO
  MONTAGEM
  OPERACAO
  DESMONTAGEM
  FINALIZADO
  CANCELADO

  @@map("event_status")
}

/// Papéis por evento. ADMIN não existe aqui de propósito: é global (users.is_admin).
enum ParticipantRole {
  GERENTE
  HEAD
  OPERACIONAL
  CLIENTE
  /// Só a Pré-produção do evento (sem campo).
  PRE_PRODUTOR

  @@map("participant_role")
}

enum OccurrenceType {
  OCORRENCIA
  TAREFA

  @@map("occurrence_type")
}

enum OccurrenceStatus {
  PENDENTE
  EM_ANDAMENTO
  URGENTE
  BLOQUEIO
  CONCLUIDO
  CANCELADO

  @@map("occurrence_status")
}

enum Priority {
  BAIXA
  NORMAL
  ALTA
  CRITICA

  @@map("priority")
}

enum ValidationStatus {
  PENDENTE
  APROVADA
  REPROVADA

  @@map("validation_status")
}

enum AttachmentKind {
  EVIDENCIA
  CONCLUSAO

  @@map("attachment_kind")
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  CONCLUDE
  CANCEL
  REASSIGN
  TEAM_CHANGE
  ROLE_CHANGE
  VALIDATE
  ACTIVATE
  DEACTIVATE
  DELETE
  LOGIN
  LOGIN_DENIED

  @@map("audit_action")
}

/// Como o item é cobrado (coluna "Tipo de faturamento" da matriz de orçamento).
enum CostBilling {
  FATURA
  NOTA_FISCAL
  DIRETO

  @@map("cost_billing")
}

enum SlaProposalStatus {
  PENDENTE
  APROVADA
  AJUSTADA
  RECUSADA

  @@map("sla_proposal_status")
}

enum NotificationType {
  NOVA
  URGENTE
  BLOQUEIO
  SLA_PROXIMO
  SLA_ESTOURADO
  CONCLUIDA
  ATRIBUIDA
  REPROVADA
  LEMBRETE

  @@map("notification_type")
}

enum DeliveryStatus {
  PENDENTE
  ENVIADO
  FALHOU
  IGNORADO

  @@map("delivery_status")
}

// ─────────────────────── Identidade e sessão ───────────────────────
// users guarda só a identidade. O que a pessoa pode ver vem de participants.
// Session/Account/Verification seguem o formato do Better Auth (etapa 2).

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  email         String   @unique @db.Citext
  name          String
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  isAdmin       Boolean  @default(false) @map("is_admin")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             Session[]
  accounts             Account[]
  participations       Participant[]    @relation("ParticipantUser")
  participantsCreated  Participant[]    @relation("ParticipantCreatedBy")
  invitationsCreated   Invitation[]
  occurrencesCreated   Occurrence[]     @relation("OccurrenceCreatedBy")
  occurrencesConcluded Occurrence[]     @relation("OccurrenceConcludedBy")
  occurrencesValidated Occurrence[]     @relation("OccurrenceValidatedBy")
  attachments          Attachment[]
  notifications        Notification[]
  whatsapp             WhatsappContact?
  serviceTypesCreated  ServiceType[]    @relation("ServiceTypeCreatedBy")
  slaProposed          SlaProposal[]    @relation("SlaProposalProposedBy")
  slaReviewed          SlaProposal[]    @relation("SlaProposalReviewedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────── Estrutura do evento ─────────────────────────

model Client {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  document    String?
  contactName String?      @map("contact_name")
  email       String?      @db.Citext
  phone       String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  events      Event[]
  occurrences Occurrence[]

  @@map("clients")
}

model Event {
  id            String      @id @default(uuid(7)) @db.Uuid
  clientId      String      @map("client_id") @db.Uuid
  name          String
  description   String?
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(3)
  venue         String?
  address       String?
  timezone      String      @default("America/Sao_Paulo")
  status        EventStatus @default(PLANEJAMENTO)
  /// Contador do número curto das ocorrências (#142). Mantido por trigger.
  occurrenceSeq Int         @default(0) @map("occurrence_seq")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  areas         Area[]
  teams         Team[]
  participants  Participant[]
  occurrences   Occurrence[]
  attachments   Attachment[]
  slaPolicies   SlaPolicy[]
  notifications Notification[]
  invitations   Invitation[]
  serviceTypes  ServiceType[]
  costSheet     CostSheet?
  costSections  CostSection[]
  costItems     CostItem[]

  @@index([clientId])
  @@index([status])
  @@map("events")
}

model Area {
  id          String       @id @default(uuid(7)) @db.Uuid
  eventId     String       @map("event_id") @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  teams        Team[]
  participants Participant[]
  occurrences  Occurrence[]

  /// Alvo das FKs compostas: garante que filhos apontem para área do MESMO evento.
  @@unique([eventId, id])
  @@index([eventId])
  @@map("areas")
}

model Team {
  id                  String       @id @default(uuid(7)) @db.Uuid
  eventId             String       @map("event_id") @db.Uuid
  areaId              String       @map("area_id") @db.Uuid
  name                String
  description         String?
  /// Líder da equipe: apenas informativo, não concede permissão.
  leaderParticipantId String?      @map("leader_participant_id") @db.Uuid
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(3)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  area         Area          @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: Restrict)
  leader       Participant?  @relation("TeamLeader", fields: [eventId, leaderParticipantId], references: [eventId, id], onDelete: NoAction)
  participants Participant[] @relation("ParticipantTeam")
  occurrences  Occurrence[]
  serviceTypes ServiceType[]

  @@unique([eventId, areaId, id])
  @@index([eventId, areaId])
  @@map("teams")
}

/// A pessoa dentro de um evento. É daqui que vem o escopo de acesso.
model Participant {
  id          String          @id @default(uuid(7)) @db.Uuid
  eventId     String          @map("event_id") @db.Uuid
  /// Preenchido quando a pessoa aceita o convite / faz login com este e-mail.
  userId      String?         @map("user_id") @db.Uuid
  name        String
  email       String          @db.Citext
  phone       String?
  jobTitle    String?         @map("job_title")
  role        ParticipantRole
  areaId      String?         @map("area_id") @db.Uuid
  teamId      String?         @map("team_id") @db.Uuid
  active      Boolean         @default(true)
  invitedAt   DateTime?       @map("invited_at") @db.Timestamptz(3)
  joinedAt    DateTime?       @map("joined_at") @db.Timestamptz(3)
  createdById String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user      User? @relation("ParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  area      Area? @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: NoAction)
  team      Team? @relation("ParticipantTeam", fields: [eventId, areaId, teamId], references: [eventId, areaId, id], onDelete: NoAction)
  createdBy User? @relation("ParticipantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  leadsTeams             Team[]              @relation("TeamLeader")
  responsibleOccurrences Occurrence[]        @relation("OccurrenceResponsible")
  invitations            Invitation[]
  serviceTypes           ServiceTypePerson[]

  @@unique([eventId, email])
  @@unique([eventId, id])
  @@index([eventId, areaId, teamId])
  @@map("participants")
}

/// Convite de acesso. Guarda só o hash do token; o link é mostrado uma única vez.
model Invitation {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Restrict)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([participantId])
  @@map("invitations")
}

// ─────────────────────────── Ocorrências ───────────────────────────

model Occurrence {
  id                       String           @id @default(uuid(7)) @db.Uuid
  /// Número curto por evento (#142). Definido por trigger na inserção.
  number                   Int              @default(0)
  type                     OccurrenceType   @default(OCORRENCIA)
  /// Copiado do evento por trigger: nunca vem do navegador.
  clientId                 String           @map("client_id") @db.Uuid
  eventId                  String           @map("event_id") @db.Uuid
  areaId                   String           @map("area_id") @db.Uuid
  teamId                   String           @map("team_id") @db.Uuid
  responsibleParticipantId String?          @map("responsible_participant_id") @db.Uuid
  /// Tipo de atendimento (pré-produção). Sempre da mesma equipe do chamado.
  serviceTypeId            String?          @map("service_type_id") @db.Uuid
  title                    String
  process                  String?
  description              String?
  status                   OccurrenceStatus @default(PENDENTE)
  priority                 Priority         @default(NORMAL)
  openedAt                 DateTime         @default(now()) @map("opened_at") @db.Timestamptz(3)
  slaDueAt                 DateTime?        @map("sla_due_at") @db.Timestamptz(3)
  concludedAt              DateTime?        @map("concluded_at") @db.Timestamptz(3)
  concludedById            String?          @map("concluded_by") @db.Uuid
  /// concluded_at − opened_at, calculado por trigger.
  durationSeconds          Int?             @map("duration_seconds")
  slaBreached              Boolean?         @map("sla_breached")
  validationStatus         ValidationStatus @default(PENDENTE) @map("validation_status")
  validatedById            String?          @map("validated_by") @db.Uuid
  validatedAt              DateTime?        @map("validated_at") @db.Timestamptz(3)
  createdById              String           @map("created_by") @db.Uuid
  /// Controle de concorrência otimista (edições offline/simultâneas).
  version                  Int              @default(1)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  client        Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  area          Area               @relation(fields: [eventId, areaId], references: [eventId, id], onDelete: Restrict)
  team          Team               @relation(fields: [eventId, areaId, teamId], references: [eventId, areaId, id], onDelete: Restrict)
  responsible   Participant?       @relation("OccurrenceResponsible", fields: [eventId, responsibleParticipantId], references: [eventId, id], onDelete: NoAction)
  concludedBy   User?              @relation("OccurrenceConcludedBy", fields: [concludedById], references: [id], onDelete: Restrict)
  validatedBy   User?              @relation("OccurrenceValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  createdBy     User               @relation("OccurrenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  serviceType   ServiceType?       @relation(fields: [eventId, areaId, teamId, serviceTypeId], references: [eventId, areaId, teamId, id], onDelete: NoAction)
  attachments   Attachment[]
  notifications Notification[]
  changes       OccurrenceChange[]

  @@unique([eventId, number])
  @@unique([eventId, id])
  @@index([eventId, status])
  @@index([eventId, areaId, status])
  @@index([eventId, teamId, status])
  @@index([responsibleParticipantId, status])
  @@index([clientId])
  @@index([serviceTypeId])
  @@map("occurrences")
}

model Attachment {
  id           String         @id @default(uuid(7)) @db.Uuid
  occurrenceId String         @map("occurrence_id") @db.Uuid
  eventId      String         @map("event_id") @db.Uuid
  storageKey   String         @unique @map("storage_key")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  width        Int?
  height       Int?
  sha256       String
  kind         AttachmentKind @default(EVIDENCIA)
  uploadedById String         @map("uploaded_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  occurrence Occurrence @relation(fields: [eventId, occurrenceId], references: [eventId, id], onDelete: Restrict)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  /// Re-sincronizar a mesma foto não duplica.
  @@unique([occurrenceId, sha256])
  @@index([occurrenceId])
  @@map("attachments")
}

model SlaPolicy {
  id            String   @id @default(uuid(7)) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  priority      Priority
  targetMinutes Int      @map("target_minutes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, priority])
  @@map("sla_policies")
}

// ─────────────────────── Auditoria e alertas ───────────────────────

/// Append-only. UPDATE/DELETE são bloqueados por trigger e por GRANT.
model AuditLog {
  id          BigInt      @id @default(autoincrement())
  occurredAt  DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?     @map("actor_user_id") @db.Uuid
  eventId     String?     @map("event_id") @db.Uuid
  entity      String
  entityId    String?     @map("entity_id") @db.Uuid
  action      AuditAction
  before      Json?
  after       Json?
  ip          String?     @db.Inet
  userAgent   String?     @map("user_agent")

  @@index([entity, entityId])
  @@index([eventId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_log")
}

model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  eventId      String?          @map("event_id") @db.Uuid
  occurrenceId String?          @map("occurrence_id") @db.Uuid
  type         NotificationType
  title        String
  body         String?
  /// Evita o mesmo aviso duas vezes para a mesma pessoa (ex.: "urgente:<chamado>").
  dedupeKey    String           @default(dbgenerated("(gen_random_uuid())::text")) @map("dedupe_key")
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event?                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrence Occurrence?            @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Envio de um aviso por um canal externo (hoje só WhatsApp).
model NotificationDelivery {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String         @map("notification_id") @db.Uuid
  channel           String         @default("WHATSAPP")
  toPhone           String         @map("to_phone")
  template          String
  status            DeliveryStatus @default(PENDENTE)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  providerMessageId String?        @map("provider_message_id")
  lastError         String?        @map("last_error")
  /// Botão "Assumir" já usado: cada mensagem vale uma vez.
  actionUsedAt      DateTime?      @map("action_used_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@map("notification_deliveries")
}

/// Número de WhatsApp da pessoa e o aceite para receber avisos.
model WhatsappContact {
  userId    String    @id @map("user_id") @db.Uuid
  phone     String
  /// null = não quer receber avisos no WhatsApp.
  optedInAt DateTime? @map("opted_in_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_contacts")
}

/// Fila de mudanças nos chamados, gravada por trigger na mesma transação.
/// O despacho de avisos lê daqui (padrão "outbox").
model OccurrenceChange {
  id           BigInt    @id @default(autoincrement())
  occurrenceId String    @map("occurrence_id") @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  kind         String
  old          Json?
  new          Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(3)

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@map("occurrence_changes")
}

/// Fotos guardadas no próprio banco (STORAGE_DRIVER=database), para hospedagens
/// sem armazenamento de arquivos à parte, como o ambiente de teste. Só lê quem
/// enxerga a foto: a RLS confere a tabela attachments.
model StoredFile {
  key         String   @id
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  body        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("stored_files")
}

// ─────────────────────── Pré-produção ───────────────────────

/// Tipo de atendimento que uma equipe faz (ex.: "Troca de lâmpada"). O SLA
/// aprovado aqui vira o prazo dos chamados deste tipo.
model ServiceType {
  id          String    @id @default(uuid(7)) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  areaId      String    @map("area_id") @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  name        String
  description String?
  /// Prazo aprovado pelo gestor, em minutos. Vazio: vale o prazo da prioridade.
  slaMinutes  Int?      @map("sla_minutes")
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  team        Team                @relation(fields: [eventId, areaId, teamId], references: [eventId, areaId, id], onDelete: Restrict)
  createdBy   User                @relation("ServiceTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  proposals   SlaProposal[]
  people      ServiceTypePerson[]
  occurrences Occurrence[]

  @@unique([eventId, areaId, teamId, id])
  @@index([eventId, areaId, teamId])
  @@map("service_types")
}

/// SLA de um tipo: proposto por quem executa, aprovado/ajustado/recusado pelo
/// gestor com comentário. O histórico fica aqui.
model SlaProposal {
  id              String            @id @default(uuid(7)) @db.Uuid
  eventId         String            @map("event_id") @db.Uuid
  areaId          String            @map("area_id") @db.Uuid
  teamId          String            @map("team_id") @db.Uuid
  serviceTypeId   String            @map("service_type_id") @db.Uuid
  minutes         Int
  note            String?
  status          SlaProposalStatus @default(PENDENTE)
  approvedMinutes Int?              @map("approved_minutes")
  feedback        String?
  proposedById    String            @map("proposed_by") @db.Uuid
  reviewedById    String?           @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceType ServiceType @relation(fields: [eventId, areaId, teamId, serviceTypeId], references: [eventId, areaId, teamId, id], onDelete: Restrict)
  proposedBy  User        @relation("SlaProposalProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("SlaProposalReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([serviceTypeId, createdAt])
  @@index([eventId, status])
  @@map("sla_proposals")
}

/// Quem faz cada tipo de atendimento (a planilha "quem faz o quê").
model ServiceTypePerson {
  eventId       String   @map("event_id") @db.Uuid
  areaId        String   @map("area_id") @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  serviceTypeId String   @map("service_type_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceType ServiceType @relation(fields: [eventId, areaId, teamId, serviceTypeId], references: [eventId, areaId, teamId, id], onDelete: Restrict)
  participant Participant @relation(fields: [eventId, participantId], references: [eventId, id], onDelete: Restrict)

  @@id([serviceTypeId, participantId])
  @@index([eventId, participantId])
  @@map("service_type_people")
}

// ─────────────────── Pré-produção: planilha de custos ───────────────────

/// Cabeçalho e percentuais do orçamento do evento (um por evento).
/// Totais seguem a matriz: honorários sobre o subtotal de fornecedores;
/// encargos "por dentro" (valor / (1 - %) - valor) na fatura e na NF.
model CostSheet {
  eventId            String   @id @map("event_id") @db.Uuid
  title              String?
  clientName         String?  @map("client_name")
  projectName        String?  @map("project_name")
  period             String?
  clientPaymentTerms String?  @map("client_payment_terms")
  author             String?
  feePct             Decimal  @default(15) @map("fee_pct") @db.Decimal(5, 2)
  invoiceTaxPct      Decimal  @default(9.5) @map("invoice_tax_pct") @db.Decimal(5, 2)
  nfTaxPct           Decimal  @default(17.5) @map("nf_tax_pct") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("cost_sheets")
}

/// Seção do orçamento (Estrutura, Cenografia, A&B...).
model CostSection {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  position  Int
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items CostItem[]

  @@unique([eventId, id])
  @@index([eventId, position])
  @@map("cost_sections")
}

/// Item do orçamento: subtotal = valor unitário × quantidade × frequência
/// (sem frequência, conta 1). Opcional aparece mas fica fora dos totais.
model CostItem {
  id           String      @id @default(uuid(7)) @db.Uuid
  eventId      String      @map("event_id") @db.Uuid
  sectionId    String      @map("section_id") @db.Uuid
  position     Int
  name         String
  description  String?
  paymentTerms String?     @map("payment_terms")
  unitValue    Decimal     @map("unit_value") @db.Decimal(14, 2)
  quantity     Decimal     @db.Decimal(12, 3)
  frequency    Decimal?    @db.Decimal(12, 3)
  optional     Boolean     @default(false)
  billing      CostBilling @default(FATURA)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  section CostSection @relation(fields: [eventId, sectionId], references: [eventId, id], onDelete: Cascade)

  @@index([eventId, sectionId, position])
  @@map("cost_items")
}
